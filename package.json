{
  "name": "vitrine-carros",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:build-seed": "tsx scripts/build-seed.ts",
    "db:reset:local": "pnpm db:build-seed && wrangler d1 migrations apply vitrine-carros --local && wrangler d1 execute vitrine-carros --local --file=./seed/seed.sql",
    "db:migrate:remote": "wrangler d1 migrations apply vitrine-carros --remote",
    "db:seed:remote": "pnpm db:build-seed && wrangler d1 execute vitrine-carros --remote --file=./seed/seed.sql",
    "cf:db:create": "wrangler d1 create vitrine-carros",
    "cf:r2:create": "wrangler r2 bucket create vitrine-carros-fotos",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:preview": "pnpm check:env && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "pnpm check:env && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "check:env": "tsx scripts/check-env.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.10",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260822.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "wrangler": "^4.125.0"
  },
  "packageManager": "pnpm@10.27.0"
}
