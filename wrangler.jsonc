{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vitrine-carros",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },

  // Banco. O database_id aponta para um banco dentro desta conta Cloudflare —
  // quem clonar o projeto precisa rodar `pnpm cf:db:create` e trocar por o seu.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vitrine-carros",
      "database_id": "1c28faa8-dc93-42b4-8f6c-ee6c6519e87d",
      "migrations_dir": "migrations"
    }
  ],

  // Fotos dos anuncios. Usado a partir da fase 2 (upload no painel).
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "vitrine-carros-fotos"
    }
  ]
}
