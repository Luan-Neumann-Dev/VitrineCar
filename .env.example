# Modelo para o `.env.local` — o arquivo NAO versionado onde ficam os dados
# reais da sua loja. Copie com `cp .env.example .env.local` e edite.
# O `.env` versionado ja traz estes mesmos valores como exemplo; o `.env.local`
# tem precedencia sobre ele, inclusive no build de producao.
#
# Identidade da loja (aparece no cabecalho, rodape e nas mensagens do WhatsApp)
NEXT_PUBLIC_STORE_NAME="Almeida Veículos"
NEXT_PUBLIC_STORE_TAGLINE="Revenda de veículos seminovos · Campinas, SP"
# Linha livre no rodape: horario, forma de atendimento, o que fizer sentido
NEXT_PUBLIC_STORE_NOTE="Atendimento por WhatsApp"
NEXT_PUBLIC_WHATSAPP_NUMBER="5519998877665"

# Dominio publico do site — usado em canonical, sitemap e dados estruturados
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Dominio publico do bucket R2 com as fotos (fase 2)
NEXT_PUBLIC_PHOTOS_BASE_URL=""

# --- Segredos do painel ---
# NAO ficam aqui. Arquivos .env viram parte do bundle publicado.
#   producao -> npx wrangler secret put ADMIN_PASSWORD
#               npx wrangler secret put ADMIN_SESSION_SECRET
#   local    -> arquivo .dev.vars (nao versionado)
# Gere a chave de sessao com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
