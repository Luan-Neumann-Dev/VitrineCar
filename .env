# Dados da loja que valem em qualquer ambiente (desenvolvimento e produção).
#
# ATENÇÃO: aqui só entram variáveis NEXT_PUBLIC_*. Elas são compiladas para
# dentro do JavaScript que vai ao navegador — não são segredo, e por isso este
# arquivo pode ser versionado. Senha e chave de sessão NUNCA entram em arquivo
# .env: vão por `wrangler secret put` (produção) e `.dev.vars` (local).
#
# Os valores abaixo são de exemplo. Para rodar com os dados da sua loja sem
# versioná-los, crie um `.env.local` (ignorado pelo Git) repetindo as chaves que
# quiser trocar — ele tem precedência sobre este arquivo, inclusive no build.

NEXT_PUBLIC_STORE_NAME="Almeida Veículos"
NEXT_PUBLIC_STORE_TAGLINE="Veículos seminovos · Campinas, SP"
NEXT_PUBLIC_STORE_NOTE="Atendimento por WhatsApp · combinamos onde ver o carro"

# 55 (Brasil) + DDD + número, só dígitos.
NEXT_PUBLIC_WHATSAPP_NUMBER="5519998877665"
